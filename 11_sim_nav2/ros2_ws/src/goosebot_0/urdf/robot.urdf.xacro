<?xml version="1.0"?>
<robot name="custom_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================ -->
  <!-- PARAMETERS - estimated from photo, adjust once you measure   -->
  <!-- the real chassis with calipers/tape measure                  -->
  <!-- ============================================================ -->
  <xacro:property name="base_length" value="0.18"/>   <!-- m -->
  <xacro:property name="base_width"  value="0.14"/>   <!-- m -->
  <xacro:property name="base_height" value="0.06"/>   <!-- m -->
  <xacro:property name="base_mass"   value="1.5"/>    <!-- kg, board stack + frame -->

  <xacro:property name="wheel_radius" value="0.03"/>  <!-- m -->
  <xacro:property name="wheel_width"  value="0.025"/> <!-- m -->
  <xacro:property name="wheel_mass"   value="0.08"/>  <!-- kg -->

  <xacro:property name="wheel_x_offset" value="0.07"/>
  <xacro:property name="wheel_y_offset" value="0.085"/>
  <xacro:property name="wheel_z_offset" value="-0.01"/>

  <!-- camera sits on a raised front bracket, well above the chassis -->
  <xacro:property name="camera_mount_height" value="0.09"/>
  <xacro:property name="camera_x_offset" value="0.05"/>

  <!-- GPS antenna sits top-center, clear sky view. Placeholder height,
       adjust once the hardware team picks a final enclosure/mast. -->
  <xacro:property name="gps_z_offset" value="${base_height/2 + 0.02}"/>

  <!-- ============================================================ -->
  <!-- MATERIALS                                                     -->
  <!-- ============================================================ -->
  <material name="chassis_dark"><color rgba="0.12 0.12 0.12 1"/></material>
  <material name="wheel_yellow"><color rgba="0.9 0.8 0.1 1"/></material>
  <material name="wheel_black"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="sensor_black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="bracket_gray"><color rgba="0.4 0.4 0.4 1"/></material>

  <!-- ============================================================ -->
  <!-- MACRO: WHEEL (yellow rim + black tire, matches photo)         -->
  <!-- ============================================================ -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_reflect*wheel_x_offset} ${y_reflect*wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- ============================================================ -->
  <!-- BASE                                                          -->
  <!-- ============================================================ -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="chassis_dark"/>
    </visual>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="${base_mass}"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.008"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Four independently driven wheels, wide stance like the photo -->
  <xacro:wheel prefix="front_left"  x_reflect="1"  y_reflect="1"/>
  <xacro:wheel prefix="front_right" x_reflect="1"  y_reflect="-1"/>
  <xacro:wheel prefix="rear_left"   x_reflect="-1" y_reflect="1"/>
  <xacro:wheel prefix="rear_right"  x_reflect="-1" y_reflect="-1"/>

  <!-- ============================================================ -->
  <!-- CAMERA MOUNT - raised bracket + camera, front of chassis      -->
  <!-- ============================================================ -->
  <link name="camera_bracket_link">
    <visual>
      <geometry><box size="0.01 0.01 ${camera_mount_height}"/></geometry>
      <material name="bracket_gray"/>
    </visual>
  </link>
  <joint name="camera_bracket_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_bracket_link"/>
    <origin xyz="${camera_x_offset} 0 ${base_height/2 + camera_mount_height/2}" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.025 0.09 0.025"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <collision>
      <geometry><box size="0.025 0.09 0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="camera_bracket_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 ${camera_mount_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- optical frame, so image data uses the standard camera convention -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ============================================================ -->
  <!-- IMU                                                           -->
  <!-- ============================================================ -->
  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- TIME-OF-FLIGHT (VL53L1X) - FRONT                              -->
  <!-- Mount position is a placeholder: hardware team hasn't picked  -->
  <!-- final placement yet. Currently sits front-center at chassis   -->
  <!-- edge height. Update x/y/z below once that's decided.          -->
  <!-- ============================================================ -->
  <xacro:property name="tof_x_offset" value="${base_length/2 + 0.02}"/>
  <xacro:property name="tof_z_offset" value="0.0"/>

  <link name="tof_front_link">
    <visual>
      <geometry><box size="0.01 0.01 0.01"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>
  <joint name="tof_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tof_front_link"/>
    <origin xyz="${tof_x_offset} 0 ${tof_z_offset}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- GPS - top-center mount, placeholder position                 -->
  <!-- Mount position is a placeholder like the ToF: hardware team   -->
  <!-- hasn't picked final enclosure placement yet. Sensor/plugin    -->
  <!-- block comes in a later step; this just establishes the        -->
  <!-- frame so TF is correct first.                                 -->
  <!-- ============================================================ -->
  <link name="gps_link">
    <visual>
      <geometry><box size="0.02 0.02 0.01"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 ${gps_z_offset}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- GZ-SIM: skid-steer drive (4 independently driven wheels,      -->
  <!-- differential steering left-pair vs right-pair)                -->
  <!--                                                                -->
  <!-- gz-sim 8's DiffDrive has NO publish_odom / publish_odom_tf /   -->
  <!-- publish_wheel_tf switches (not in its documented parameter     -->
  <!-- list); those tags were silently ignored and DiffDrive kept     -->
  <!-- publishing its own odom->base_footprint TF. They are removed,  -->
  <!-- and <frame_id>/<child_frame_id>/<tf_topic> are left at their   -->
  <!-- namespaced defaults (<model>/odom, /model/<name>/tf) so this   -->
  <!-- plugin can never collide with the EKF's odom->base_footprint.  -->
  <!-- Real odom TF comes from robot_localization only.               -->
  <!-- ============================================================ -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <update_rate>50</update_rate>

      <!-- front pair -->
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>

      <!-- rear pair -->
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>${wheel_y_offset*2}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <max_wheel_torque>10</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>

      <topic>cmd_vel</topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- ============================================================ -->
  <!-- GZ-SIM: camera sensor                                          -->
  <!--                                                                -->
  <!-- libgazebo_ros_camera.so is gone entirely — Harmonic's Sensors  -->
  <!-- system (loaded once at the world level in maze.world) natively  -->
  <!-- simulates any <sensor type="camera"> and auto-publishes it on   -->
  <!-- gz-transport. The <topic> tag below just gives it a predictable -->
  <!-- name instead of the generated default, so the bridge config can -->
  <!-- target it. horizontal_fov is still the same provisional         -->
  <!-- placeholder noted below — swap in the calibrated value once    -->
  <!-- you've run camera_calibration.                                  -->
  <!-- ============================================================ -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="front_camera">
      <update_rate>30.0</update_rate>
      <topic>camera/image</topic>
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.5708</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>300</far></clip>
      </camera>
      <!-- gz-sim publishes camera_info automatically alongside the
           image topic; confirm the exact name once running with
           `gz topic -l`, it should be camera/camera_info. -->
    </sensor>
  </gazebo>

  <!-- ============================================================ -->
  <!-- GZ-SIM: ToF (VL53L1X) sensor - front                           -->
  <!--                                                                -->
  <!-- libgazebo_ros_ray_sensor.so is gone. Harmonic has no built-in   -->
  <!-- sensor that emits a single sensor_msgs/Range the way the old    -->
  <!-- plugin's output_type did — the closest native equivalent is a  -->
  <!-- lidar sensor. Sensor type "ray" -> "gpu_lidar" and the <ray>    -->
  <!-- block is renamed <lidar>, but the narrow 5x2 sample grid below  -->
  <!-- is unchanged, so it still behaves like a near-point beam rather -->
  <!-- than a wide sonar cone.                                         -->
  <!--                                                                -->
  <!-- ** Message type change, flagging explicitly: ** this now        -->
  <!-- publishes sensor_msgs/LaserScan (via the bridge), not            -->
  <!-- sensor_msgs/Range like before. If anything downstream            -->
  <!-- subscribes expecting Range, it'll need a small adapter node,     -->
  <!-- or you can read scan.ranges[0] directly.                         -->
  <!-- ============================================================ -->
  <gazebo reference="tof_front_link">
    <sensor type="gpu_lidar" name="tof_front_sensor">
      <update_rate>20.0</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <topic>tof_front/scan</topic>
      <gz_frame_id>tof_front_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.4</min_angle>
            <max_angle>0.4</max_angle>
          </horizontal>
          <vertical>
            <samples>2</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.07</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.04</min>
          <max>8.0</max>
          <resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>  <!-- VL53L1X is +/-1-2cm typical, tune once calibrated -->
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ============================================================ -->
  <!-- GZ-SIM: GPS (NavSat) sensor                                    -->
  <!--                                                                -->
  <!-- Like the camera/IMU, this is native to Harmonic's Sensors      -->
  <!-- system; no separate plugin needed, just a <sensor              -->
  <!-- type="navsat"> block. It emits gz.msgs.NavSat, which the       -->
  <!-- bridge config (next step) maps to sensor_msgs/NavSatFix.       -->
  <!--                                                                -->
  <!-- update_rate is deliberately slow (5 Hz); real consumer GPS     -->
  <!-- modules update at 1-10 Hz, much slower than IMU/ToF. Noise     -->
  <!-- stddevs below are rough placeholders for an uncorrected        -->
  <!-- consumer GPS (~1.5m horizontal, ~3m vertical); tighten these   -->
  <!-- once you know the actual module (e.g. RTK would be far        -->
  <!-- better than this).                                             -->
  <!-- ============================================================ -->
  <gazebo reference="gps_link">
    <sensor type="navsat" name="gps_sensor">
      <update_rate>5.0</update_rate>
      <always_on>true</always_on>
      <topic>gps/fix</topic>
      <gz_frame_id>gps_link</gz_frame_id>
      <navsat>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.5</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>3.0</stddev>
            </noise>
          </vertical>
        </position_sensing>
      </navsat>
    </sensor>
  </gazebo>

  <!-- ============================================================ -->
  <!-- GZ-SIM GROUND TRUTH POSE - sim-only, feeds the perfect-map    -->
  <!-- localization bridge. Not present on real hardware.             -->
  <!--                                                                -->
  <!-- libgazebo_ros_p3d.so -> gz-sim-odometry-publisher-system. This  -->
  <!-- is the standard drop-in replacement for p3d: it publishes       -->
  <!-- ground-truth odometry computed directly from the model's true   -->
  <!-- pose (not from wheel encoders), same as p3d did. It only        -->
  <!-- publishes an odometry message — no tf — so it can't collide   -->
  <!-- with the wheel odometry's /tf output above.                     -->
  <!-- ============================================================ -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>ground_truth/pose</odom_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

  <!-- ============================================================ -->
  <!-- GZ-SIM: IMU sensor                                             -->
  <!--                                                                -->
  <!-- libgazebo_ros_imu_sensor.so is gone. Like the camera, IMU is    -->
  <!-- native SDF and the Sensors system simulates it directly — the  -->
  <!-- <imu> block below (noise config included) is byte-for-byte      -->
  <!-- unchanged from the classic-Gazebo version. Only the plugin      -->
  <!-- wrapper is removed; <topic> replaces the old ROS namespace/     -->
  <!-- remapping for naming the output.                                -->
  <!-- ============================================================ -->
  <gazebo reference="imu_link">
    <sensor type="imu" name="imu_sensor">
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
      <topic>imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>
